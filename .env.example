# HAVENLY Environment Configuration
# Copy this file to .env or .env.local to connect to your Supabase project.

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (Found in Supabase Dashboard -> Project Settings -> API)
# This key is safe to use in frontend code because database Row Level Security (RLS) protects your data.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE FOR DEVELOPERS:
# If these environment variables are left blank or unset, Havenly automatically boots in
# 'Simulated Cloud Mode' (with localStorage persistence). This allows you to test
# Student, Owner, and Admin portals immediately without any setup, and seamlessly switch to
# real Supabase whenever you drop in your keys!
